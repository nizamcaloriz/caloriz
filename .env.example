# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AdMob Configuration (Production)
# Get your Ad Unit IDs from: https://admob.google.com/
# Step-by-step guide: See ADMOB_LIVE_ADS_SETUP.md

# Android Rewarded Ad Unit ID (e.g., ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy)
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# iOS Rewarded Ad Unit ID (e.g., ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy)
ADMOB_IOS_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
